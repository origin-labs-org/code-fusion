    "@origin-ai/cf-llm": "*",
    "@origin-ai/cf-sandbox": "*",
    "@origin-ai/cf-sandbox-policy": "*",
    "@origin-ai/cf-system-prompt": "*",
    "@origin-ai/cf-jobs": "*",
    "@origin-ai/cf-tools": "*",
    "@origin-ai/cf-user-approval": "*",
    "@deepseek-ai/cordis": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@origin-ai/cf-agent": "*",
    "@origin-ai/cf-shell": "*",
    "@origin-ai/cf-shell-env": "*",
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-llm": "*",
    "@origin-ai/cf-loader-smoke": "*",
    "@origin-ai/cf-pwsh-local": "*",
    "@origin-ai/cf-sandbox": "*",
