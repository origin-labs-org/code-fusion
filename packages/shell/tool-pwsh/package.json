    "@origin-ai/cf-subprocess-local": "*",
    "@origin-ai/cf-system-prompt": "*",
    "@origin-ai/cf-jobs": "*",
    "@origin-ai/cf-jobs-local": "*",
    "@origin-ai/cf-tool-jobs": "*",
    "@origin-ai/cf-tools": "*",
    "@origin-ai/cf-user-approval": "*",
    "@deepseek-ai/cordis": "*"
  }
