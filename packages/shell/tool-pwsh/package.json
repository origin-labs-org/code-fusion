    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@origin-ai/cf-agent": "*",
    "@origin-ai/cf-shell": "*",
