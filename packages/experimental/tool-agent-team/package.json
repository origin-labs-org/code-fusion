{
  "name": "@origin-ai/cf-experimental-tool-agent-team",
  "description": "Scoped model-facing Agent Teams tools over ctx.agentTeams",
  "version": "0.1.1-rc.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/origin-labs-ai/code-fusion.git",
    "directory": "packages/experimental/tool-agent-team"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependencies": {
    "@origin-ai/cf-agent": "*",
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-session": "*",
    "@origin-ai/cf-system-prompt": "*",
    "@origin-ai/cf-experimental-agent-team": "*",
    "@origin-ai/cf-tools": "*",
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@origin-ai/cf-agent": "*",
    "@origin-ai/cf-agent-loop": "*",
    "@origin-ai/cf-agent-loop-testkit": "*",
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-session": "*",
    "@origin-ai/cf-session-persistence-jsonl": "*",
    "@origin-ai/cf-scope": "*",
    "@origin-ai/cf-subagent": "*",
    "@origin-ai/cf-subagent-fork-in-process": "*",
    "@origin-ai/cf-subagent-spawn-in-process": "*",
    "@origin-ai/cf-tool-subagent-control": "*",
    "@origin-ai/cf-system-prompt": "*",
    "@origin-ai/cf-experimental-agent-team": "*",
    "@origin-ai/cf-tools": "*",
    "@deepseek-ai/cordis": "*"
  }
}
