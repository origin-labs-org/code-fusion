{
  "name": "@origin-ai/cf-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/origin-labs-ai/code-fusion.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependencies": {
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-llm": "*",
    "@origin-ai/cf-output-retention": "*",
    "@origin-ai/cf-session": "*",
    "@origin-ai/cf-spill": "*",
    "@origin-ai/cf-subprocess": "*",
    "@origin-ai/cf-system-prompt": "*",
    "@origin-ai/cf-timeout": "*",
    "@origin-ai/cf-tools": "*",
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@origin-ai/cf-agent": "*",
    "@origin-ai/cf-subprocess": "*",
    "@origin-ai/cf-subprocess-local": "*",
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-llm": "*",
    "@origin-ai/cf-output-retention": "*",
    "@origin-ai/cf-session": "*",
    "@origin-ai/cf-spill": "*",
    "@origin-ai/cf-system-prompt": "*",
    "@origin-ai/cf-timeout": "*",
    "@origin-ai/cf-tools": "*",
    "@deepseek-ai/cordis": "*"
  }
}
