{
  "name": "@origin-ai/cf-tmux-context",
  "description": "Opt-in durable per-step context with this agent's tmux pane and window location",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/origin-labs-ai/code-fusion.git",
    "directory": "packages/context/tmux-context"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependencies": {
    "@origin-ai/cf-agent": "*",
    "@origin-ai/cf-shell": "*",
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-session": "*",
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@origin-ai/cf-agent": "*",
    "@origin-ai/cf-shell": "*",
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-llm": "*",
    "@origin-ai/cf-session": "*",
    "@origin-ai/cf-system-prompt": "*",
    "@deepseek-ai/cordis": "*"
  }
}
