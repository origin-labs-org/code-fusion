{
  "name": "@origin-ai/cf-client-runtime",
  "description": "Client core services: SlotRegistry, SessionRuntime (scope tree + object layer)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/origin-labs-ai/code-fusion.git",
    "directory": "packages/client/runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "cf": {
    "client": {
      "inject": [
        "@origin-ai/cf-client-connection",
        "@origin-ai/cf-typert-registry",
        "@origin-ai/cf-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "immer": "^10.1.1",
    "zustand": "~4.4.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@origin-ai/cf-api-remotes": "*",
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-typert-protocol": "*",
    "@origin-ai/cf-typert-registry": "*",
    "@origin-ai/cf-agent": "*",
    "@origin-ai/cf-attachment": "*",
    "@origin-ai/cf-client-connection": "*",
    "@origin-ai/cf-commands": "*",
    "@origin-ai/cf-host-apiproxy": "*",
    "@origin-ai/cf-llm": "*",
    "@origin-ai/cf-llm-retry": "*",
    "@origin-ai/cf-session": "*",
    "@origin-ai/cf-session-projection": "*",
    "@origin-ai/cf-session-title": "*",
    "@origin-ai/cf-tools": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@origin-ai/cf-api-remotes": "*",
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-timeout": "*",
    "@origin-ai/cf-typert-protocol": "*",
    "@origin-ai/cf-typert-registry": "*",
    "@types/react": "~18.3.1",
    "@origin-ai/cf-client-ui-slots": "*",
    "react": "^18.2.0",
    "@origin-ai/cf-agent": "*",
    "@origin-ai/cf-attachment": "*",
    "@origin-ai/cf-client-connection": "*",
    "@origin-ai/cf-commands": "*",
    "@origin-ai/cf-host-apiproxy": "*",
    "@origin-ai/cf-llm": "*",
    "@origin-ai/cf-llm-retry": "*",
    "@origin-ai/cf-session": "*",
    "@origin-ai/cf-session-projection": "*",
    "@origin-ai/cf-session-title": "*",
    "@origin-ai/cf-tools": "*"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
