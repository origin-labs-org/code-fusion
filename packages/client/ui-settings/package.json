{
  "name": "@origin-ai/cf-client-ui-settings",
  "description": "Settings domain base plugin: the settings-namespace scope service and the canonical settings slot-type contract",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/origin-labs-ai/code-fusion.git",
    "directory": "packages/client/ui-settings"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "cf": {
    "client": {
      "inject": [
        "@origin-ai/cf-client-connection",
        "@origin-ai/cf-client-runtime",
        "@origin-ai/cf-api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@origin-ai/cf-api-remotes": "*",
    "@origin-ai/cf-client-connection": "*",
    "@origin-ai/cf-client-runtime": "*",
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-settings": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@origin-ai/cf-api-remotes": "*",
    "@origin-ai/cf-client-runtime": "*",
    "@origin-ai/cf-client-test-runtime": "*",
    "@origin-ai/cf-client-ui-slots": "*",
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-settings": "*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@origin-ai/cf-client-connection": "*"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
