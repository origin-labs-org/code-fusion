{
  "name": "@origin-ai/cf-client-web",
  "description": "Web boot kernel: static module table, Cordis loader, framework-free boot page, and UI-renderer handoff",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/origin-labs-ai/code-fusion.git",
    "directory": "packages/client/web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "*",
    "@origin-ai/cf-client-modules": "*",
    "@origin-ai/cf-client-ui-renderer": "*",
    "@origin-ai/cf-client-ui-primitives": "*",
    "@origin-ai/cf-client-ui-slots": "*",
    "@origin-ai/cf-invariants": "*",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@deepseek-ai/cordis": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@origin-ai/cf-invariants": "*",
    "@deepseek-ai/cordis": "*"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/**/*.css",
    "lib/types/**/*.d.ts"
  ]
}
