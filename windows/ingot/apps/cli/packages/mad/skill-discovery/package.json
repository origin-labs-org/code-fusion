{
  "name": "@origin-ai/cf-skill-discovery",
  "description": "CF Skill Discovery: GitHub auto-discovery with mandatory trust gate search→rank→vet→fetch→activate",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/origin-labs-ai/code-fusion.git",
    "directory": "packages/mad/skill-discovery"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./src/invariant.ts",
      "default": "./src/invariant.ts"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "@origin-ai/cf-brand": "workspace:*",
    "@origin-ai/cf-invariants": "workspace:*",
    "@deepseek-ai/cordis": "workspace:*"
  },
  "devDependencies": {
    "@origin-ai/cf-brand": "workspace:*",
    "@origin-ai/cf-invariants": "workspace:*",
    "@deepseek-ai/cordis": "workspace:*"
  },
  "private": true
}
