{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out/e2e",
    "rootDir": ".",
    "lib": [
      "es2024",
      "dom",
      "dom.iterable"
    ],
    "types": [
      "node",
      "@wdio/globals/types",
      "@wdio/electron-types",
      "mocha"
    ],
    "noEmit": true,
    "paths": {
      "@origin-ai/cf-e2e-report": [
        "../e2e-report/src/node/index.ts"
      ]
    }
  },
  "include": ["wdio.conf.ts", "test/e2e", "src/host/botRemoteWorkspaceResolver.ts", "src/host/sourceServerDirectory.ts", "src/host/windowRemoteConnectionRegistry.ts"],
  "references": [
    { "path": "../shared" },
    { "path": "../ui" },
    { "path": "../e2e-report" },
    { "path": "../cf-server-cli" }

  ]
}
