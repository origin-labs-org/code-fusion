{
  "version": 1,
  "caseName": "conversation-session-terminal-expanded-details-and-status",
  "spec": "./test/e2e/conversation-session/conversation-session-terminal-expanded-details-and-status.test.ts",
  "fixtures": [
    {
      "id": "tge02-title",
      "metadata": {
        "kind": "common",
        "source": "synthetic",
        "timingPolicy": "fast-text",
        "syntheticReason": "Provide auto-titles for the two new sessions in this case, isolating replay without relying on legacy shared title fixtures."
      },
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": ["Generate a concise title", "E2E_TERMINAL_EXPANDED_"]
      },
      "response": {
        "statusCode": 200,
        "text": {
          "id": "tge02-title",
          "text": "{\"title\":"Terminal E2E"}",
          "inputTokens": 96,
          "outputTokens": 16
        }
      }
    },
    {
      "id": "tge02-success-command",
      "description": "TGE02 emits the successful Terminal child.",
      "metadata": {
        "kind": "main",
        "source": "synthetic",
        "timingPolicy": "tool-use",
        "syntheticReason": "Pin success child and stdout to reliably verify expanded details."
      },
      "maxMatches": 1,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": ["E2E_TERMINAL_EXPANDED_FAILURE_STATUS"],
        "bodyExcludes": ["Generate a concise title", "toolu_tge02_success"]
      },
      "response": {
        "statusCode": 200,
        "toolUse": {
          "id": "toolu_tge02_success",
          "name": "Bash",
          "input": {
            "command": "node -e \"console.log('TGE02_SUCCESS_OUTPUT')\""
          }
        }
      }
    },
    {
      "id": "tge02-nonzero-command",
      "description": "TGE02 emits a completed Bash child whose command exits nonzero.",
      "metadata": {
        "kind": "main",
        "source": "synthetic",
        "timingPolicy": "tool-use",
        "syntheticReason": "Pin non-zero exit code and stderr to verify that command business failure remains a completed Bash tool result."
      },
      "maxMatches": 1,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": ["E2E_TERMINAL_EXPANDED_FAILURE_STATUS", "toolu_tge02_success"],
        "bodyExcludes": ["Generate a concise title", "toolu_tge02_failed"]
      },
      "response": {
        "statusCode": 200,
        "toolUse": {
          "id": "toolu_tge02_failed",
          "name": "Bash",
          "input": {
            "command": "node -e \"console.error('TGE02_FAILURE_OUTPUT'); process.exit(7)\""
          }
        }
      }
    },
    {
      "id": "tge02-command-final",
      "description": "TGE02 completes the Terminal command-count turn.",
      "metadata": {
        "kind": "main",
        "source": "synthetic",
        "timingPolicy": "fast-text",
        "syntheticReason": "Pin ending the turn after non-zero command returns, bringing parent command count to a stable terminal state."
      },
      "maxMatches": 1,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": ["E2E_TERMINAL_EXPANDED_FAILURE_STATUS", "toolu_tge02_failed"],
        "bodyExcludes": ["Generate a concise title"]
      },
      "response": {
        "statusCode": 200,
        "text": "upstream-e2e-ok"
      }
    },
    {
      "id": "tge02-stopped-command",
      "description": "TGE02 emits a long command for the user-stop window.",
      "metadata": {
        "kind": "main",
        "source": "synthetic",
        "timingPolicy": "tool-use",
        "syntheticReason": "Long local command reliably keeps a Stop window to test the stopped state of a single Bash card."
      },
      "maxMatches": 1,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": ["E2E_TERMINAL_EXPANDED_STOP_STATUS"],
        "bodyExcludes": ["Generate a concise title", "toolu_tge02_stopped"]
      },
      "response": {
        "statusCode": 200,
        "toolUse": {
          "id": "toolu_tge02_stopped",
          "name": "Bash",
          "input": {
            "command": "node -e \"setTimeout(() => console.log('TGE02_STOP_SHOULD_NOT_FINISH'), 60000)\""
          }
        }
      }
    }
  ]
}
