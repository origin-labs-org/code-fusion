        "syntheticReason": "Use CDD01 marker to isolate title requests, preventing title generation from affecting main path replay."
      },
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": ["Generate a concise title", "E2E_CDD01_BEFORE_MIGRATION"]
