{
  "version": 1,
  "caseName": "conversation-session-mcp-oauth-status-isolation",
  "spec": "./test/e2e/conversation-session/conversation-session-mcp-oauth-status-isolation.test.ts",
  "fixtures": [
    {
      "id": "upstream-mcp-oauth-status-isolation-direct-call",
      "description": "Call the still-connected user-level stdio MCP ping tool first after OAuth authorization completes.",
      "metadata": {
        "kind": "main",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "Stably trigger real tools/call of user-level stdio MCP, avoiding reliance on the model to select tools autonomously."
      },
      "maxMatches": 1,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "lastUserMessageIncludes": ["E2E_MCP_OAUTH_STATUS_ISOLATION"],
        "bodyIncludes": [
          "E2E_MCP_OAUTH_STATUS_ISOLATION",
          "mcp__everything__ping",
          "mcp__plain_http__ping"
        ],
        "bodyExcludes": ["Generate a concise title", "CRITICAL: Respond with TEXT ONLY"]
      },
      "response": {
        "statusCode": 200,
        "toolUse": {
          "id": "toolu_e2e_mcp_oauth_status_isolation_direct",
          "name": "mcp__everything__ping",
          "input": {
            "marker": "E2E_MCP_OAUTH_STATUS_ISOLATION"
          }
        }
      }
    },
    {
      "id": "upstream-mcp-oauth-status-isolation-http-call",
      "description": "Call normal unauthenticated HTTP MCP ping tool after consuming stdio MCP tool_result.",
      "metadata": {
        "kind": "main",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "Verify that after OAuth status refresh, stdio MCP tool_result can enter provider continuation and continue selecting normal HTTP MCP."
      },
      "maxMatches": 1,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": [
          "E2E_MCP_OAUTH_STATUS_ISOLATION",
          "toolu_e2e_mcp_oauth_status_isolation_direct",
          "E2E_MCP_DIRECT_PONG:E2E_MCP_OAUTH_STATUS_ISOLATION",
          "mcp__plain_http__ping"
        ],
        "bodyExcludes": ["Generate a concise title", "CRITICAL: Respond with TEXT ONLY"]
      },
      "response": {
        "statusCode": 200,
        "toolUse": {
          "id": "toolu_e2e_mcp_oauth_status_isolation_http",
          "name": "mcp__plain_http__ping",
          "input": {
            "marker": "E2E_MCP_OAUTH_STATUS_ISOLATION"
          }
        }
      }
    },
    {
      "id": "upstream-mcp-oauth-status-isolation-final",
      "description": "Consume real tool_result from both stdio and normal HTTP MCP and complete the session.",
      "metadata": {
        "kind": "main",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "Verify that tool_result from both types of user MCPs can enter provider continuation."
      },
      "maxMatches": 1,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": [
          "E2E_MCP_OAUTH_STATUS_ISOLATION",
          "toolu_e2e_mcp_oauth_status_isolation_direct",
          "E2E_MCP_DIRECT_PONG:E2E_MCP_OAUTH_STATUS_ISOLATION",
          "toolu_e2e_mcp_oauth_status_isolation_http",
          "E2E_MCP_HTTP_PONG:E2E_MCP_OAUTH_STATUS_ISOLATION"
        ],
        "bodyExcludes": ["Generate a concise title", "CRITICAL: Respond with TEXT ONLY"]
      },
      "response": {
        "statusCode": 200,
        "text": "upstream-e2e-ok"
      }
    }
  ]
}
