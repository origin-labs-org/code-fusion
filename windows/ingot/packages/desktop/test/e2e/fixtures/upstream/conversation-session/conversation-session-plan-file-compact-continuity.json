        "text": {
          "id": "upstream-e2e-plan-file-compact-summary-success",
          "inputTokens": 256,
          "outputTokens": 64,
          "text": "<analysis>Manual compact summarized the approved plan and checkpoint turn.</analysis>\n\n<summary>The user approved E2E_PLAN_FILE_COMPACT_PLAN_BODY and then sent E2E_PLAN_FILE_COMPACT_CHECKPOINT before manual compact.</summary>"
