      "response": {
        "delayMs": 3000,
        "statusCode": 500,
        "statusMessage": "Internal Server Error",
        "headers": {
          "content-type": "application/json; charset=utf-8"
        },
        "body": "{\"error\":{\"message\":"synthetic provider failure","type":"provider_error","code":"e2e_turn_error"}}"
      }
    },
    {
      "id": "turn-error-queue-preserved-followup",
      "description": "NQ: Post-error head input successfully consumed upon explicit continuation.",
      "metadata": {
        "kind": "main",
        "timingPolicy": "fast-text",
        "source": "synthetic",
