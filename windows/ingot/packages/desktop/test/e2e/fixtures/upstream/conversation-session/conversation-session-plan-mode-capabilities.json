      "maxMatches": 1,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": [
          "E2E_PLAN_MODE_TOOL_BOUNDARY_MIXED",
          "toolu_e2e_plan_mode_boundary_write",
          "toolu_e2e_plan_mode_boundary_read",
          "Plan mode only allows read-only, non-destructive tools",
          "E2E_READONLY_TOOL_FILE_CONTENT"
        ],
        "bodyExcludes": [
          "Generate a concise title",
          "CRITICAL: Respond with TEXT ONLY"
        ]
      },
      "response": {
        "statusCode": 200,
        "text": "upstream-e2e-ok"
