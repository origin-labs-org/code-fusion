      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "lastUserMessageIncludes": [
          "E2E_PLAN_MODE_DENY_NEXT_INPUT"
        ],
        "bodyIncludes": [
          "E2E_PLAN_MODE_DENY_NEXT_INPUT",
          "Plan mode is active",
          "MUST NOT make any edits"
        ],
        "bodyExcludes": [
          "Generate a concise title",
          "CRITICAL: Respond with TEXT ONLY"
        ]
      },
      "response": {
        "statusCode": 200,
        "text": "upstream-e2e-ok"
      }
    },
    {
      "id": "upstream-plan-mode-boundary-enter-plan-call",
      "description": "First-round request in tool boundary case reliably returns EnterPlanMode.",
      "metadata": {
        "kind": "main",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "Need to stably induce plan mode state to avoid relying on whether the real model chooses EnterPlanMode."
      },
