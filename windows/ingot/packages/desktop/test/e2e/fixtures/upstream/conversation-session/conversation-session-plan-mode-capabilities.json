          "toolu_e2e_plan_mode_deny_enter_plan_mode"
        ],
        "bodyExcludes": [
          "Generate a concise title",
          "CRITICAL: Respond with TEXT ONLY"
        ]
      },
      "response": {
        "statusCode": 200,
        "toolUse": {
          "id": "toolu_e2e_plan_mode_deny_exit_plan_mode",
          "name": "ExitPlanMode",
          "input": {
            "plan": "E2E_PLAN_MODE_DENY_PLAN_BODY: 1. Inspect current implementation. 2. Wait for user approval before edits."
          }
        }
      }
    },
    {
      "id": "upstream-plan-mode-deny-follow-up-final",
      "description": "After denying ExitPlanMode without feedback, the next user input still carries plan mode reminder and can complete.",
      "metadata": {
        "kind": "main",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "需要断言 deny without feedback 停止当前 turn，但不退出 plan mode。"
