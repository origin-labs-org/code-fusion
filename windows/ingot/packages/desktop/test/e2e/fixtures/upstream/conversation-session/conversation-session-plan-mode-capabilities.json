      },
      "response": {
        "statusCode": 200,
        "toolUses": [
          {
            "id": "toolu_e2e_plan_mode_boundary_write",
            "name": "Write",
            "input": {
              "file_path": "{{e2eRuntimeRoot}}/conversation-session-plan-mode-capabilities/cf-e2e-plan-mode-denied-write.txt",
              "content": "this file must not be written in plan mode\n"
            }
          },
          {
            "id": "toolu_e2e_plan_mode_boundary_read",
            "name": "Read",
            "input": {
              "file_path": "{{e2eRuntimeRoot}}/shared/readonly-tool.txt"
            }
          }
        ]
      }
    },
    {
      "id": "upstream-plan-mode-boundary-final",
      "description": "Returns fixed text after provider-visible request contains both write rejection and read-only Read results.",
      "metadata": {
        "kind": "main",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "Core contract is that write rejection tool_result and real Read tool_result appear together in the same continuation."
