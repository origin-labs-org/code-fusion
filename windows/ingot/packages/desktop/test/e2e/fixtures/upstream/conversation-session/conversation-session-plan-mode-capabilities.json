          "E2E_PLAN_MODE_TOOL_BOUNDARY_MIXED"
        ],
        "bodyExcludes": [
          "Generate a concise title",
          "CRITICAL: Respond with TEXT ONLY"
        ]
      },
      "response": {
        "statusCode": 200,
        "toolUse": {
          "id": "toolu_e2e_plan_mode_boundary_enter_plan_mode",
          "name": "EnterPlanMode",
          "input": {}
        }
      }
    },
    {
      "id": "upstream-plan-mode-boundary-mixed-tools-call",
      "description": "Returns Write and Read within the same assistant reply; Write should be rejected by plan mode while Read still executes.",
      "metadata": {
        "kind": "main",
