{
  "version": 1,
  "caseName": "conversation-session-background-subagent-rate-limit",
  "spec": "./test/e2e/conversation-session/conversation-session-background-subagent-rate-limit.test.ts",
  "fixtures": [
    {
      "id": "background-subagent-rate-limit-title",
      "description": "background subagent rate limit case 的固定标题响应。",
      "metadata": {
        "kind": "common",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "Title generation does not belong to this case; simply return stably to avoid mismatched business fixtures."
      },
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "bodyIncludes": ["Generate a concise title", "E2E_BACKGROUND_SUBAGENT_RATE_LIMIT_PARENT"]
      },
      "response": {
        "statusCode": 200,
        "statusMessage": "OK",
        "headers": {
          "content-type": "application/json; charset=utf-8"
        },
        "body": "{\"id\":"upstream-e2e-background-subagent-rate-limit-title","type":"message","role":"assistant","model":"deepseek-v4-flash","content":[{\"type\":"text","text":\"{\\\"title\\\":\\\"Background Agent 429\\\"}\"}],"stop_reason":"end_turn","stop_sequence":null,"usage":{\"input_tokens\":125,"cache_creation_input_tokens":0,"cache_read_tokens":0,"output_tokens":24,"service_tier":"standard"}}"
      }
    },
    {
      "id": "background-subagent-rate-limit-parent-launch",
      "description": "父模型启动一个 background Agent。",
      "metadata": {
        "kind": "main",
        "timingPolicy": "fast-tool-use",
        "source": "synthetic",
        "syntheticReason": "Stably create a real Agent(run_in_background=true) to cover terminal notification projection."
      },
      "maxMatches": 1,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "lastUserMessageIncludes": ["E2E_BACKGROUND_SUBAGENT_RATE_LIMIT_PARENT"],
        "bodyIncludes": [
          "E2E_BACKGROUND_SUBAGENT_RATE_LIMIT_PARENT",
          "E2E_BACKGROUND_SUBAGENT_RATE_LIMIT_PARENT_DONE"
        ],
        "bodyExcludes": [
          "Async agent launched successfully",
          "Generate a concise title",
          "CRITICAL: Respond with TEXT ONLY"
        ]
      },
      "response": {
        "statusCode": 200,
        "toolUse": {
          "id": "toolu_e2e_background_subagent_rate_limit_agent",
          "name": "Agent",
          "input": {
            "description": "世界杯冠军预测分析",
            "prompt": "E2E_BACKGROUND_SUBAGENT_RATE_LIMIT_CHILD: make one provider request; the replay server will return a stable 429.",
            "run_in_background": true,
            "subagent_type": "general-purpose"
          }
        }
      }
    },
    {
      "id": "background-subagent-rate-limit-parent-launch-ack",
      "description": "Parent model ends current turn after background Agent launch ACK.",
      "metadata": {
        "kind": "main",
        "timingPolicy": "fast-text",
        "source": "synthetic",
        "syntheticReason": "让父会话先回 idle，随后由 failed task notification 唤醒。"
