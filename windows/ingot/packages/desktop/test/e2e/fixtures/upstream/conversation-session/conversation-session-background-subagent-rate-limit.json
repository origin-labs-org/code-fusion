          "toolu_e2e_background_subagent_rate_limit_agent"
        ],
        "bodyExcludes": [
          "Generate a concise title",
          "CRITICAL: Respond with TEXT ONLY"
        ],
        "lastUserMessageExcludes": ["<task-notification>"]
      },
      "response": {
        "statusCode": 200,
        "text": {
          "id": "upstream-e2e-background-subagent-rate-limit-launch-ack",
          "text": "background-subagent-rate-limit-launched-ok"
        }
      }
    },
    {
      "id": "background-subagent-rate-limit-child-initial-429",
      "description": "First request with child-only marker delays returning 429 to ensure parent turn consumes launch ACK first.",
      "metadata": {
        "kind": "subagent",
        "timingPolicy": "fault-stream",
        "source": "synthetic",
        "syntheticReason": "The first 429 is delayed until the parent turn consumes the launch ACK; BG26 worker disables model retry and only verifies raw error projection in terminal/UI/snapshot."
      },
      "maxMatches": 1,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "lastUserMessageIncludes": ["E2E_BACKGROUND_SUBAGENT_RATE_LIMIT_CHILD"],
        "bodyIncludes": ["E2E_BACKGROUND_SUBAGENT_RATE_LIMIT_CHILD"],
        "bodyExcludes": ["Generate a concise title", "CRITICAL: Respond with TEXT ONLY"]
      },
      "response": {
        "statusCode": 429,
        "statusMessage": "Too Many Requests",
        "delayMs": 1500,
        "headers": {
          "content-type": "application/json; charset=utf-8",
          "retry-after": "0"
        },
        "body": "{\"error\":{\"code\":"AccountRateLimitExceeded","message":"Requests are too frequent. Please reduce your request frequency, wait a short moment, and retry your request. Request id: e2e-background-subagent-rate-limit","param":null,"type":"TooManyRequests"}}"
      }
    },
    {
      "id": "background-subagent-rate-limit-parent-notification",
      "description": "父模型消费 failed background Agent notification。",
      "metadata": {
        "kind": "main",
        "timingPolicy": "task-notification",
        "source": "synthetic",
        "syntheticReason": "Demonstrate that failed notification returns to parent model via runtime command queue and wraps up properly."
      },
      "maxMatches": 1,
      "match": {
        "method": "POST",
        "pathIncludes": "/messages",
        "lastUserMessageIncludes": ["<task-notification>", "<status>failed</status>"],
        "bodyIncludes": [
          "E2E_BACKGROUND_SUBAGENT_RATE_LIMIT_PARENT",
          "<tool-use-id>toolu_e2e_background_subagent_rate_limit_agent</tool-use-id>",
          "<status>failed</status>"
        ],
        "bodyExcludes": ["Generate a concise title", "CRITICAL: Respond with TEXT ONLY"]
      },
      "response": {
        "statusCode": 200,
        "text": {
          "id": "upstream-e2e-background-subagent-rate-limit-parent-done",
          "text": "E2E_BACKGROUND_SUBAGENT_RATE_LIMIT_PARENT_DONE"
        }
      }
    }
  ]
