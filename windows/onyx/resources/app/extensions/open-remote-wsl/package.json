{"name":"open-remote-wsl","displayName":"Open Remote - WSL","description":"Open any folder in the Windows Subsystem for Linux (WSL).","version":"0.0.1","publisher":"aicoding","l10n":"./l10n","icon":"resources/icon.png","engines":{"vscode":"^1.70.2"},"extensionKind":["ui"],"enabledApiProposals":["resolvers","contribViewsRemote"],"keywords":["remote development","remote","wsl"],"api":"none","activationEvents":["onResolveRemoteAuthority:wsl","onStartupFinished"],"capabilities":{"untrustedWorkspaces":{"supported":true}},"main":"./dist/extension.js","contributes":{"configuration":{"title":"Remote - WSL","properties":{"remote.WSL.bridgeMode":{"type":"string","enum":["auto","always","never"],"enumDescriptions":["First try WSL2 localhostForwarding (TCP probe on 127.0.0.1:<port>); fall back to the Windows-side bridge only when the probe fails. Recommended.","Always route traffic through the Windows-side bridge (spawns `wsl.exe` per connection). Use when localhostForwarding is known to be broken (AV/VPN/mirrored networking).","Never use the bridge; always rely on WSL2 localhostForwarding. Use this only if the bridge itself is causing problems."],"default":"auto","description":"How to reach the qoder-server inside a WSL distro. 'auto' (default) prefers WSL2 localhostForwarding and falls back to a Windows-side TCP bridge that pipes connections through `wsl.exe` only when the direct path is unavailable."},"remote.WSL.useBridge":{"type":"boolean","default":null,"markdownDeprecationMessage":"Deprecated. Use `#remote.WSL.bridgeMode#` instead. When set, `true` is interpreted as `always` and `false` as `never`; otherwise `bridgeMode` wins.","description":"Deprecated. Use 'remote.WSL.bridgeMode' instead."}}},"views":{"remote":[{"id":"wslTargets","name":"WSL Targets","group":"targets@1","when":"(isWindows && !isWeb)","remoteName":"wsl"}]},"commands":[{"command":"openremotewsl.connect","title":"Connect to WSL","category":"Remote-WSL"},{"command":"openremotewsl.connectInNewWindow","title