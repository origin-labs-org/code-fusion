    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": {
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-llm": "*",
    "@origin-ai/cf-session": "*",
    "@origin-ai/cf-session-title": "*",
    "@origin-ai/cf-session-title-llm": "*",
    "@deepseek-ai/cordis": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "*",
    "@deepseek-ai/cordis-plugin-loader": "*",
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-llm": "*",
    "@origin-ai/cf-llm-deepseek": "*",
    "@origin-ai/cf-session": "*",
    "@origin-ai/cf-session-title": "*",
    "@origin-ai/cf-session-title-llm": "*",
    "@deepseek-ai/cordis": "*"
  }
}
