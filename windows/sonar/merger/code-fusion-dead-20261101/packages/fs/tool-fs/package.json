{
  "name": "@origin-ai/cf-tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the CodeFusion filesystem seam (ctx.fs)",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/origin-labs-ai/code-fusion.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependencies": {
    "@origin-ai/cf-attachment": "*",
    "@origin-ai/cf-fs": "*",
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-llm": "*",
    "@origin-ai/cf-sandbox": "*",
    "@origin-ai/cf-sandbox-policy": "*",
    "@origin-ai/cf-session": "*",
    "@origin-ai/cf-system-prompt": "*",
    "@origin-ai/cf-tools": "*",
    "@origin-ai/cf-user-approval": "*",
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@origin-ai/cf-agent": "*",
    "@origin-ai/cf-agent-loop": "*",
    "@origin-ai/cf-agent-loop-testkit": "*",
    "@origin-ai/cf-attachment": "*",
    "@origin-ai/cf-fs": "*",
    "@origin-ai/cf-fs-local": "*",
    "@origin-ai/cf-fs-observation-policy": "*",
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-llm": "*",
    "@origin-ai/cf-llm-deepseek": "*",
    "@origin-ai/cf-sandbox": "*",
    "@origin-ai/cf-sandbox-policy": "*",
    "@origin-ai/cf-session": "*",
    "@origin-ai/cf-system-prompt": "*",
    "@origin-ai/cf-tools": "*",
    "@origin-ai/cf-user-approval": "*",
    "@deepseek-ai/cordis": "*"
  }
}
