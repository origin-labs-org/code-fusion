{
  "name": "@origin-ai/cf-subagent-spawn-in-process",
  "description": "In-process spawn subagent backend: runs a fresh child agent on ctx.agents",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/origin-labs-ai/code-fusion.git",
    "directory": "packages/subagent/subagent-spawn-in-process"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-subagent": "*",
    "@origin-ai/cf-subagent-in-process-driver": "*",
    "@deepseek-ai/cordis": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "*",
    "@origin-ai/cf-agent": "*",
    "@origin-ai/cf-agent-loop": "*",
    "@origin-ai/cf-agent-loop-testkit": "*",
    "@origin-ai/cf-bash-local": "*",
    "@origin-ai/cf-subprocess-local": "*",
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-llm": "*",
    "@origin-ai/cf-llm-deepseek": "*",
    "@origin-ai/cf-session": "*",
    "@origin-ai/cf-subagent": "*",
    "@origin-ai/cf-subagent-in-process-driver": "*",
    "@origin-ai/cf-tool-bash": "*",
    "@origin-ai/cf-tool-subagent": "*",
    "@deepseek-ai/cordis": "*"
  }
}
