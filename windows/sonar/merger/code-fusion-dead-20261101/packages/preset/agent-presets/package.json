{
  "name": "@origin-ai/cf-agent-presets",
  "description": "Per-session agent composition from preset cordis.yml files for the CodeFusion",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/origin-labs-ai/code-fusion.git",
    "directory": "packages/preset/agent-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-include": "*",
    "@deepseek-ai/cordis-plugin-loader": "*",
    "@origin-ai/cf-agent": "*",
    "@origin-ai/cf-atomic-write": "*",
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-home-paths": "*",
    "@origin-ai/cf-scope": "*",
    "@origin-ai/cf-session": "*",
    "@origin-ai/cf-settings": "*",
    "@origin-ai/cf-system-prompt": "*",
    "@deepseek-ai/cordis": "*"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "*",
    "@deepseek-ai/cordis-plugin-loader": "*",
    "@origin-ai/cf-agent": "*",
    "@origin-ai/cf-agent-loop": "*",
    "@origin-ai/cf-atomic-write": "*",
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-llm": "*",
    "@origin-ai/cf-home-paths": "*",
    "@origin-ai/cf-scope": "*",
    "@origin-ai/cf-session": "*",
    "@origin-ai/cf-settings": "*",
    "@origin-ai/cf-settings-file": "*",
    "@origin-ai/cf-system-prompt": "*",
    "@origin-ai/cf-tools": "*",
    "@deepseek-ai/cordis": "*"
  }
}
