{
  "name": "@origin-ai/cf-llm-retry",
  "description": "Provider-routed LLM request retry policy for the CodeFusion",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/origin-labs-ai/code-fusion.git",
    "directory": "packages/llm/llm-retry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@origin-ai/cf-brand": "*",
    "@origin-ai/cf-agent": "*",
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-llm": "*",
    "@origin-ai/cf-session": "*",
    "@origin-ai/cf-timeout": "*",
    "@deepseek-ai/cordis": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@origin-ai/cf-brand": "*",
    "@deepseek-ai/cordis-plugin-include": "*",
    "@deepseek-ai/cordis-plugin-loader": "*",
    "@origin-ai/cf-agent": "*",
    "@origin-ai/cf-agent-loop": "*",
    "@origin-ai/cf-agent-loop-testkit": "*",
    "@origin-ai/cf-invariants": "*",
    "@origin-ai/cf-llm": "*",
    "@origin-ai/cf-llm-deepseek": "*",
    "@origin-ai/cf-llm-mock-server": "*",
    "@origin-ai/cf-session": "*",
    "@origin-ai/cf-session-persistence-jsonl": "*",
    "@origin-ai/cf-session-persistence-sqlite": "*",
    "@origin-ai/cf-system-prompt": "*",
    "@origin-ai/cf-timeout": "*",
    "@origin-ai/cf-tools": "*",
    "@deepseek-ai/cordis": "*"
  }
}
